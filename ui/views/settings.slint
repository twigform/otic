import { styles } from "../styles.slint";
import { ScrollView, ListView, Button } from "std-widgets.slint";
import { DirsState, CurrentSettingsView } from "../globals.slint";
import { dirs } from "../components/dirs.slint";
import { settingsSide } from "../components/settingsSide.slint";
import { themeSettings } from "../components/theme.slint";

// TODO: redesign settings page

export component settingsView inherits HorizontalLayout {
    settingsSide {}
    Rectangle {
        width: 1px;
        background: styles.theme.container.border;
        vertical-stretch: 1;
    }

    if CurrentSettingsView.selected-settings-view == 0 : dirs {}
    if CurrentSettingsView.selected-settings-view == 1 : themeSettings {}
}
