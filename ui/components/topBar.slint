import { styles } from "../styles.slint";
import { CurrentView, WindowState } from "../globals.slint";

export component topBar inherits Rectangle {
    background: styles.theme.container.background;
    border-radius: styles.border-radius;
    height: 32px;


    WindowMoveArea {
        HorizontalLayout {
            padding: styles.margin / 2;
            spacing: styles.margin;

            home-button := Rectangle{
                width: 24px;
                height: 24px;
                border-radius: styles.border-radius;
                background: CurrentView.selected-view == 0
                    ? styles.theme.container.floating
                    : transparent;

                    Image {
                        source: @image-url("../assets/icons/home.svg");
                        width: 16px;
                        height: 16px;
                        colorize: styles.theme.container.text;
                    }

                TouchArea {
                    mouse-cursor: pointer;
                    clicked => {
                        CurrentView.selected-view = 0;
                    }
                }
            }

            settings-button := Rectangle{
                width: 24px;
                height: 24px;
                border-radius: styles.border-radius;
                background: CurrentView.selected-view == 1
                    ? styles.theme.container.floating
                    : transparent;

                    Image {
                        source: @image-url("../assets/icons/settings.svg");
                        width: 16px;
                        height: 16px;
                        colorize: styles.theme.container.text;
                    }

                TouchArea {
                    mouse-cursor: pointer;
                    clicked => {
                        CurrentView.selected-view = 1;
                    }
                }
            }

            Rectangle {
                horizontal-stretch: 1;
            }

            theme-button := Rectangle{
                width: 24px;
                height: 24px;
                border-radius: styles.border-radius;
                background: styles.theme.container.floating;

                Image {
                    source: styles.isDark ? @image-url("../assets/icons/dark.svg") : @image-url("../assets/icons/light.svg");
                    width: 16px;
                    height: 16px;
                    colorize: styles.theme.container.text;
                }

                TouchArea {
                    mouse-cursor: pointer;
                    clicked => {
                        styles.isDark = !styles.isDark;
                    }
                }
            }

            minimize-button := Rectangle {
                width: 24px;
                height: 24px;
                border-radius: styles.border-radius;
                background: minimize-touch.has-hover ? styles.theme.container.floating : transparent;
                animate background { duration: 100ms; easing: styles.easing; }

                Image {
                    source: @image-url("../assets/icons/minimize.svg");
                    width: 20px;
                    height: 20px;
                    colorize: styles.theme.container.text;
                }

                minimize-touch := TouchArea {
                    mouse-cursor: pointer;
                    clicked => { WindowState.minimize(); }
                }
            }

            fullscreen-button := Rectangle {
                width: 24px;
                height: 24px;
                border-radius: styles.border-radius;
                background: fullscreen-touch.has-hover ? styles.theme.container.floating : transparent;
                animate background { duration: 100ms; easing: styles.easing; }

                Image {
                    source: @image-url("../assets/icons/fullscreen.svg");
                    width: 20px;
                    height: 20px;
                    colorize: styles.theme.container.text;
                }

                fullscreen-touch := TouchArea {
                    mouse-cursor: pointer;
                    clicked => { WindowState.toggle-fullscreen(); }
                }
            }

            close-button := Rectangle {
                width: 24px;
                height: 24px;
                border-radius: styles.border-radius;
                background: close-touch.has-hover ? #e81123 : transparent;
                animate background { duration: 100ms; easing: styles.easing; }

                Image {
                    source: @image-url("../assets/icons/close.svg");
                    width: 20px;
                    height: 20px;
                    colorize: close-touch.has-hover ? white : styles.theme.container.text;
                }

                close-touch := TouchArea {
                    mouse-cursor: pointer;
                    clicked => { WindowState.close(); }
                }
            }
        }
    }
}
